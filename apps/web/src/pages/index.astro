---
// Raíz del sitio: redirige al idioma del navegador. Astro no permite negociar
// idioma en el servidor sin un adaptador con SSR completo, así que se hace con
// un pequeño script inline + <meta refresh> como red de seguridad sin JS.
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirigiendo…</title>
    <script is:inline>
      const userLang = navigator.language || navigator.userLanguage;
      window.location.href = userLang.startsWith('ca') ? '/ca/' : '/es/';
    </script>
    <meta http-equiv="refresh" content="0;url=/es/" />
  </head>
  <body>
    <p>Redirigiendo... <a href="/es/">Continuar</a></p>
  </body>
</html>
