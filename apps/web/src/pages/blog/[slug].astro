---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

// Antes esta página usaba getStaticPaths() -- generaba las rutas una sola
// vez en el build, así que un artículo nuevo (o recién publicado) no
// aparecía hasta el siguiente deploy. Se cambia a prerender=false (una
// consulta por visita) para que el Blog refleje lo que hay en el panel al
// momento. Como ya no hay getStaticPaths filtrando los publicados de
// antemano, hay que filtrar is_published aquí explícitamente o un borrador
// quedaría visible por URL directa.
export const prerender = false;

const { slug } = Astro.params;
const { data: blog } = await supabase
  .from('blogs')
  .select('*')
  .eq('slug', slug)
  .eq('is_published', true)
  .single();

if (!blog) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={`${blog.title} | Alicia Gómez Cuéllar`}
  description={blog.excerpt || ''}
  lang="es"
>
  <article class="py-16 md:py-32 px-6">
    <div class="max-w-2xl mx-auto">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent mb-10 hover:gap-2.5 transition-all">
        <span aria-hidden="true">←</span> Volver al blog
      </a>
      <h1 class="text-4xl md:text-5xl mb-4">{blog.title}</h1>
      <time class="text-sm text-slate-400 block mb-10">
        {new Date(blog.published_at).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>

      <div
        class="prose prose-slate max-w-none prose-headings:font-normal prose-a:text-accent prose-strong:text-primary"
        set:html={blog.content}
      />
    </div>
  </article>
</BaseLayout>
