---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

// Sin esto, Astro hornea el listado una sola vez en el build (mismo motivo
// que en blog/[slug].astro) y un artículo nuevo no aparece hasta el
// siguiente deploy.
export const prerender = false;

const { data: blogs } = await supabase
  .from('blogs')
  .select('*')
  .eq('is_published', true)
  .order('published_at', { ascending: false });
---

<BaseLayout
  title="Blog | Alicia Gómez Cuéllar"
  description="Artículos y novedades sobre Derecho Civil y Administrativo."
  lang="es"
>
  <section class="py-16 md:py-32 px-6">
    <div class="max-w-3xl mx-auto">
      <header class="mb-16 text-center">
        <span class="text-xs font-bold uppercase tracking-[2px] text-accent">Blog</span>
        <h1 class="text-4xl md:text-5xl mt-3">Artículos y actualidad legal</h1>
      </header>

      <div class="space-y-6">
        {blogs && blogs.length > 0 ? (
          blogs.map((blog: any) => (
            <article class="border border-primary/10 rounded-2xl p-8 bg-white hover:border-accent/50 hover:shadow-lg transition-all duration-300">
              <h2 class="text-2xl mb-2">
                <a href={`/blog/${blog.slug}`} class="hover:text-accent transition-colors">{blog.title}</a>
              </h2>
              <time class="text-sm text-slate-400 block mb-4">
                {new Date(blog.published_at).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {blog.excerpt && <p class="text-slate-600 leading-relaxed">{blog.excerpt}</p>}
              <a href={`/blog/${blog.slug}`} class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-accent hover:gap-2.5 transition-all">
                Leer más <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        ) : (
          <p class="text-center text-slate-400 py-16">Todavía no hay artículos publicados.</p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
