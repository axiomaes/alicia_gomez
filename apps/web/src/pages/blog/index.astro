---
import { supabase, getTenantSettings } from '../../lib/supabase';

// Fetch published blogs
const { data: blogs } = await supabase
  .from('blogs')
  .select('*')
  .eq('is_published', true)
  .order('published_at', { ascending: false });

const tenant = await getTenantSettings();
const tenantName = tenant?.tenant_name || 'Cliente Base';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog - {tenantName}</title>
  </head>
  <body class="bg-zinc-50 text-zinc-900 antialiased font-sans max-w-4xl mx-auto p-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight">Nuestro Blog</h1>
      <p class="text-zinc-500 mt-2">Novedades y artículos.</p>
    </header>

    <main class="space-y-8">
      {blogs && blogs.map((blog) => (
        <article class="border border-zinc-200 rounded-2xl p-6 hover:shadow-md transition-shadow bg-white">
          <h2 class="text-2xl font-semibold mb-2">
            <a href={`/blog/${blog.slug}`} class="text-indigo-600 hover:underline">{blog.title}</a>
          </h2>
          <time class="text-sm text-zinc-500 block mb-4">
            {new Date(blog.published_at).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <p class="text-zinc-600">{blog.excerpt}</p>
          <a href={`/blog/${blog.slug}`} class="inline-block mt-4 text-sm font-medium text-indigo-600 hover:text-indigo-800">Leer más &rarr;</a>
        </article>
      ))}
      {(!blogs || blogs.length === 0) && (
        <p class="text-zinc-500 text-center py-12">No hay artículos publicados todavía.</p>
      )}
    </main>
  </body>
</html>
