---
import { getContent } from '../lib/supabase';
import type { ResolvedTheme } from '../lib/theme';

interface Props {
  lang: 'es' | 'ca';
  theme?: ResolvedTheme;
  content?: Record<string, string>;
}

const { lang, theme, content } = Astro.props;
const logoUrl = theme?.logoUrl ?? '/logos/logo_alicia_gomez.svg';
const tenantName = theme?.tenantName ?? 'Alicia Gómez Cuéllar';

const c = content ?? await getContent(lang);
---

<!-- Diseño fiel al footer original de Alicia: una sola columna centrada
     (logo, descripción, LinkedIn, línea, copyright) — no la plantilla
     genérica de 3 columnas a la izquierda del starter, que es lo que
     hacía que se viera "descentrado" en móvil. -->
<footer class="py-6 md:py-16 px-6 bg-slate-900 text-white relative overflow-hidden">
  <div class="max-w-lg mx-auto flex flex-col items-center text-center gap-6 relative z-10">
    <div class="flex items-center gap-3">
      <img src={logoUrl} alt={tenantName} class="h-10 w-auto" />
      <div class="flex flex-col leading-none text-left">
        <span class="text-white font-bold text-lg tracking-tighter">{tenantName}</span>
        <span class="text-accent text-[10px] font-bold uppercase tracking-widest leading-none mt-1">{c['footer.brand'] || 'TU MARCA AQUÍ'}</span>
      </div>
    </div>

    <p class="text-slate-400 text-sm leading-relaxed">
      {c['footer.desc'] || 'Plantilla base de Axioma Starter para el despliegue rápido de sitios web corporativos con CMS integrado.'}
    </p>

    {c['company.linkedin'] && (
      <a
        href={c['company.linkedin']}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="flex items-center justify-center w-9 h-9 rounded-full border border-white/15 text-accent hover:border-accent transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </a>
    )}

    <div class="w-10 h-px bg-white/10"></div>

    <p class="text-xs text-slate-500">
      &copy; {new Date().getFullYear()} {tenantName}. {c['company.nif_label'] || 'Nº colegiada'} {c['company.nif'] || ''}. {c['footer.rights'] || 'Todos los derechos reservados.'}
      {c['footer.legal'] && <> · <a href="#" class="hover:text-white transition">{c['footer.legal']}</a></>}
    </p>
  </div>
</footer>
